# Conso backend (extracted from the extension; override only if it changes)
SUPABASE_URL=https://jzxlayjrsdbyzykuiqns.supabase.co
SUPABASE_KEY=sb_publishable_clAiRg6ffCznEAtg_bn19Q_yY0W5Hyd
CONSO_WEB=https://www.conso.xyz

# Identity generation
# Catch-all / disposable domain used for account emails.
EMAIL_DOMAIN=
DISPLAY_NAME_PREFIX=user
PASSWORD_LENGTH=16

# Referral code applied to EVERY newly registered account (redeemed after
# create_consouser, before onboarding/consoname).
DEFAULT_REFERRAL_CODE=

# Skip farming an account whose remaining daily budget is below this many zaps.
# At 20.83/21 the server still accepts turns but sizes each one down to ~0.02,
# so finishing the last fraction costs a dozen requests and adds nothing.
# 0 disables the skip.
MIN_REMAINING_ZAPS=1.0

# Concurrency + pacing
CONCURRENCY=4
MAX_CONCURRENCY=16
REQUEST_TIMEOUT=30
MAX_RETRIES=3
# Pacing between TURNS on one account (reuses one session -> needs long gaps).
MIN_DELAY_SECONDS=20
MAX_DELAY_SECONDS=60
# Pacing between SIGNUPS (registration only). Each signup is a fresh identity
# and, with PROXY_PER_ACCOUNT=1, a distinct IP, so this can be far shorter.
# Keeping the 20-60s turn delay here would serialise the worker pool.
REGISTER_MIN_DELAY_SECONDS=2
REGISTER_MAX_DELAY_SECONDS=6

# Transport fingerprint
IMPERSONATE=chrome
USER_AGENT=

# HTTP proxy pool used for the account/turn traffic (signup, RPC calls).
# One proxy per account is pinned automatically (PROXY_PER_ACCOUNT=1), which
# spreads the server's signup-velocity limit across IPs.
#   PROXY_URLS  -> comma-separated URLs inline
#   PROXY_FILE  -> path to a file, one http://user:pass@host:port per line
# Empty = direct (no proxy).
PROXY_URLS=
PROXY_FILE=
PROXY_PER_ACCOUNT=1

# Verification adapter: none | imap | tempmail | mailtm | ncaori | temptf
#   temptf  -> temp.tf real Gmail/Outlook/Hotmail aliases (RECOMMENDED: these
#              domains pass Conso's allowlist; no API key; OTP arrives here)
#   mailtm  -> mail.tm (free, no key; domain uberip.com is BLOCKED by Conso)
#   ncaori  -> temp-mail.ncaori.my.id (26 domains; needs NCAORI_API_KEY)
VERIFIER=temptf
TEMPTF_PROVIDER=gmail

# CAPTCHA — Conso enforces Cloudflare Turnstile on ALL Supabase auth endpoints.
# sitekey = 0x4AAAAAAEzmjKoKI6TA61_6
#
# CAPTCHA_PROVIDER is a comma-chain: the first provider that returns a token
# wins, so a rate-flagged local IP degrades into the next provider instead of
# failing the registration. Providers whose credentials/deps are missing are
# skipped automatically.
#
#   internal  -> the IN-PROCESS port of waguriagentic/captcha-solver
#                (src/conso/solver/cloak/). No sidecar, no HTTP server.
#                Requires: pip install cloakbrowser  (scripts/setup_cloak.sh)
#                NOTE: upstream ships with NO license — private use only,
#                see src/conso/solver/cloak/NOTICE.md.
#   camoufox  -> stealth-Firefox solver with production evidence (58 accounts).
#                Requires: scripts/setup_camoufox.sh
#   capsolver -> Capsolver managed API (browser-free, paid; CAPSOLVER_API_KEY)
#   2captcha  -> 2Captcha managed API  (browser-free, paid; TWOCAPTCHA_API_KEY)
#   manual    -> operator pastes a token into CAPTCHA_TOKEN
#   none      -> no solving; only useful with CAPTCHA_TOKEN preset
#
# Default when unset: cloak,camoufox  (both in-process, no paid key needed).
# scripts/setup_all.sh installs Camoufox, so that is the ready provider out of
# the box; add `internal` here after running scripts/setup_cloak.sh.
# A typical resilient chain: internal,camoufox,capsolver,2captcha
CAPTCHA_PROVIDER=camoufox

# A pre-solved token (used by the `manual`/`none` providers, or as a last-ditch
# single-use token when everything else is unavailable).
CAPTCHA_TOKEN=

# Managed APIs
CAPSOLVER_API_KEY=
# api = pure-HTTP Capsolver client (default) | sdk = official capsolver SDK
CAPSOLVER_MODE=api
# Proxy handed to Capsolver for the solve (its own egress, not the account's).
CAPSOLVER_PROXY=
TWOCAPTCHA_API_KEY=

# Proxy used by the CAPTCHA SOLVER itself (separate from PROXY_FILE above).
# Leave empty to let the solver use the machine's direct IP. When set, each
# solve attempt rotates to the next line in the file.
# Note: datacenter proxies rarely pass Turnstile — residential ones do.
SOLVER_PROXY_FILE=
# How entries from SOLVER_PROXY_FILE are handed out:
#   attempt (default) -> next entry on every retry attempt
#   worker            -> each worker thread keeps ONE entry for its whole run,
#                        and different workers get different ones. Pair with
#                        SOLVER_SERIAL=0 so parallel workers solve from distinct
#                        source IPs (one usable challenge flow per IP).
# Datacenter proxies are rejected by Turnstile regardless of mode — this needs
# residential IPs to actually help.
SOLVER_PROXY_MODE=attempt

# Solver envelope shared by every in-process provider.
SOLVER_HEADLESS=1
# Per-solve budget (seconds) before the whole solve is abandoned.
SOLVER_TIMEOUT=90
# Camoufox browser concurrency. 8 is the measured sweet spot; 16 overloads a
# single browser (page navigation timeouts).
SOLVER_MAX_CONCURRENT=8
# Minimum seconds between solves. Cloudflare rate-flags a rapid-solve IP, so
# space solves out; 45s is the safe batch-registration value.
SOLVER_SOLVE_DELAY=5
# Fail-fast solve tuning: a rate-flagged IP never returns a token, so instead of
# one long timeout the solve is split into short attempts that rotate strategy.
#   SOLVER_ATTEMPTS        -> attempts per solve (default 3)
#   SOLVER_ATTEMPT_TIMEOUT -> per-attempt budget in seconds (default 45)
#   SOLVER_BACKOFF         -> seconds between attempts (default 3)
SOLVER_ATTEMPTS=3
SOLVER_ATTEMPT_TIMEOUT=45
SOLVER_BACKOFF=3
# Cloudflare issues one usable challenge flow per source IP: overlapping solves
# from the same IP make every participant time out (measured 4 parallel -> 0/4,
# 3 serial with SOLVER_SOLVE_DELAY=45 -> 3/3). Solves are therefore serialised
# process-wide by default. Set 0 ONLY when each worker exits via its own
# residential IP (then parallel solves are safe again).
SOLVER_SERIAL=1

# Cloak provider (CAPTCHA_PROVIDER contains `internal`) only.
CLOAK_HEADLESS=1
# Attach a GeoIP database so the browser's timezone/locale match the exit IP.
CLOAK_GEOIP=0
# Cloak sessions are heavier than Camoufox contexts; keep this low.
CLOAK_MAX_CONCURRENT=2

# Ncaori Mail+ (VERIFIER=ncaori)
NCAORI_API=https://temp-mail.ncaori.my.id
NCAORI_API_KEY=

# IMAP (catch-all mailbox) — used when VERIFIER=imap
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
IMAP_SENDER_FILTER=

# TempMail API — used when VERIFIER=tempmail
TEMPMAIL_API=
TEMPMAIL_KEY=

# Optional: send run summaries to Telegram.
# Create a bot with @BotFather, then get the chat id (send the bot a message
# and read https://api.telegram.org/bot<TOKEN>/getUpdates).
# Leave either blank and nothing is sent. Failure to deliver never fails a run.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Storage
DATA_DIR=data
LOGS_DIR=logs

# Optional: remote host that runs the daily earn cycle (scripts/sync_accounts.sh).
# Registration needs a residential IP, so it stays local; the remote only needs
# stored sessions, which refresh without ever touching the captcha.
SSH_HOST=
SSH_KEY=
# SSH_PORT=22
